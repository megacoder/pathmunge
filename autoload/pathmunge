# vim: ai sm noet nu nornu ts=8 sw=8 ff=unix filetype=zsh
# This is intended to be sourced during zsh(1) startup.
# Do not try to execute this file standalone

pathmunge() {
	local	DIR
	local	SPELLING
	case "$1" in
	"list" | "" )
		local index=1
		for DIR in "${path[@]}"; do
			printf "[%02d] %s\n" "$index" "$DIR"
			((index++))
		done
	;;

	"rm" | "del" | "remove" | "delete" )
		if [[ -z "$2" ]]; then
			print "Error: Please specify a directory path to remove." >&2
			return 1
		fi
		path=("${path[@]:#$2}")
	;;


	*)
		# Directory must exist
		SPELLING="${1}"
		if [[ ! -d "${SPELLING}" ]]; then
			print "Error: directoy must already exist and '${SPELLING}' does not." >&2
		fi
		# Dedup first
		path=("${path[@]:#$1}")
		# Standard addition behavior
		if [[ "$2" == "after" ]]; then
			path+=("${SPELLING}")
		else
			path=("${SPELLING}" $path)
		fi
	;;
	esac
}
